---
// The logo's symbol, drawn inline so it follows the color mode: three blocks
// in a grid, and the envelope held over the dashed slot that is the fourth.
// Its styles are in styles/site.css.
---

<svg
  aria-hidden="true"
  class="site-mark"
  viewBox="0 0 108 108"
>
  <rect class="site-mark-block" height="44" rx="6" width="44" x="0" y="12"
  ></rect>
  <rect class="site-mark-block" height="44" rx="6" width="44" x="0" y="64"
  ></rect>
  <rect class="site-mark-block" height="44" rx="6" width="44" x="52" y="64"
  ></rect>
  <rect
    class="site-mark-slot"
    fill="none"
    height="41"
    rx="5"
    stroke-dasharray="6 4.36"
    stroke-width="3"
    width="41"
    x="53.5"
    y="13.5"></rect>
  <rect class="site-mark-gap" height="50" rx="9" width="50" x="58" y="0"></rect>
  <rect class="site-mark-envelope" height="44" rx="6" width="44" x="61" y="3"
  ></rect>
  <polyline
    fill="none"
    points="68,11 83,24 98,11"
    stroke="#fff"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="4.5"></polyline>
</svg>
