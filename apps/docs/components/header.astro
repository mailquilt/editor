---
// Blume's own header, without "Try the Playground" on the Playground itself.
import Header from "blume/components/layout/Header.astro";

const { navigation, route } = Astro.props;
const onPlayground = route === "/playground";
---

<Header
  {...Astro.props}
  navigation={onPlayground ? { ...navigation, cta: undefined } : navigation}
/>
