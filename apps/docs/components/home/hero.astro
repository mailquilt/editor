---
// The top of the landing page: what Mail Quilt is, and its editor.
import { withBase } from "blume/components/islands/base-path.ts";

import { DEFAULT_ACCENT } from "../../site/editor-facts.ts";
import { capitalized, COUNTS } from "../../site/package-facts.ts";

const facts = [
  { name: "License", value: "MIT, with no paid tier" },
  {
    name: "Packages",
    value: `${capitalized(COUNTS.packages)}, each built on the last`,
  },
  { name: "Works with", value: "Any framework, with a React component" },
  { name: "You keep", value: "Each email, as JSON" },
  { name: "You send", value: "HTML, written by MJML" },
  { name: "Status", value: "0.x, so the API can still change" },
];

/**
 * The editor's accent and its pressed shade, as a host would set them. The
 * first matches this site, and the second is what the editor uses when nobody
 * sets any. The page mixes the tints from the accent, as on the Playground.
 */
const themes = [
  { accent: "#d4380f", name: "Orange, to match this site", strong: "#b5300c" },
  { ...DEFAULT_ACCENT, name: "Blue, the editor's default" },
  { accent: "#7c3aed", name: "Violet", strong: "#6d28d9" },
  { accent: "#16181d", name: "Graphite", strong: "#000000" },
];
---

<section class="site-section home-hero">
  <div class="site-wrap">
    <h1 class="site-h1">
      Build an email editor into your app<span
        aria-hidden="true"
        class="site-period"></span>
    </h1>

    <div class="home-hero-row">
      <div>
        <p class="site-lead">
          Mail Quilt is a set of free, open-source packages. Drop in a
          ready-made editor page, build your own page around the drag-and-drop
          editor, or build on the document model underneath.
        </p>
        <div class="site-actions">
          <a
            class="site-button"
            data-tone="accent"
            href={withBase("/playground")}>Try the Playground</a
          >
          <a
            class="site-button"
            data-tone="quiet"
            href={withBase("/docs/quick-start")}>Read the quick start</a
          >
        </div>
      </div>
      <dl class="site-facts home-facts">
        {
          facts.map(({ name, value }) => (
            <div>
              <dt>{name}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- The editor sits lifted out of a dashed slot, as the envelope does in the logo. -->
    <div class="home-slot">
      <!-- Once the editor is live, its Blocks and panels are a long way to Tab through. -->
      <a class="home-skip site-button" data-tone="quiet" href="#editor-themes"
        >Skip past the editor</a
      >
      <div class="home-editor" data-home-editor>
        <img
          alt="The Mail Quilt editor. An email sits on a canvas, with a side panel of Blocks to drag onto it."
          height="1202"
          sizes="(min-width: 81rem) 71rem, 100vw"
          src={withBase("/editor.webp")}
          srcset={`${withBase("/editor-small.webp")} 1136w, ${withBase("/editor.webp")} 2272w`}
          width="2272"
        />
      </div>
    </div>
    <p class="home-phone-note site-small site-muted">
      This is a picture. The editor needs more room than this, so open the
      page in a wider window to try it.
    </p>
    <p class="home-start-note site-small site-muted">
      This is a picture of the editor, which starts here once the page has
      loaded. If it doesn't, try it in the{" "}
      <a class="site-link" href={withBase("/playground")}>Playground</a>.
    </p>
    <div
      class="home-themes site-small"
      data-home-themes
      id="editor-themes"
      tabindex="-1">
      <span id="themes-label"
        >This is the editor, one of the {COUNTS.packages} packages, recolored
        with theme tokens. Try another:</span
      >
      <div aria-labelledby="themes-label" class="home-swatches" role="group">
        {
          themes.map(({ accent, name, strong }, index) => (
            <button
              aria-label={name}
              aria-pressed={index === 0 ? "true" : "false"}
              data-accent={accent}
              data-strong={strong}
              style={`--swatch:${accent}`}
              title={name}
              type="button"
            />
          ))
        }
      </div>
      <code data-home-token>--mq-color-accent: {themes[0]?.accent}</code>
    </div>
  </div>
</section>
