---
// What to know before relying on it. The table of email clients is on its docs
// page alone, so it's only ever updated there.
import { withBase } from "blume/components/islands/base-path.ts";

import { EDITOR_MIN_WIDTH } from "../../site/editor-facts.ts";
---

<section class="site-section">
  <div class="site-wrap site-split">
    <div>
      <h2 class="site-h2">Before you rely on it</h2>
      <p>
        Mail Quilt is young, and it's better you read that here than find it
        out later.
      </p>
    </div>
    <div>
      <ul class="site-list">
        <li>
          It's at version 0.x, so the API can still change between releases.
        </li>
        <li>
          It doesn't send email, store emails or host anything. It's a
          component in your app.
        </li>
        <li>
          Editing needs the editor to be at least {EDITOR_MIN_WIDTH} pixels
          wide. On a phone, people can still preview an email.
        </li>
        <li>
          Images are added by URL. There's no upload yet, and no library of
          templates.
        </li>
        <li>
          Classic Outlook for Windows shows emails with a few limits, such as
          black-and-white emoji, and dark mode can change an email's colors.
        </li>
      </ul>
      <div class="site-actions">
        <a class="site-link" href={withBase("/docs/email-clients")}
          >Read about email client testing</a
        >
      </div>
    </div>
  </div>
</section>
