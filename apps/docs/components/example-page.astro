---
// One example email on a page of its own, so each can be found by what it is,
// such as a receipt email template. Each example has a file of its own under
// pages/examples/ that renders this, rather than one [slug] route, because
// Blume leaves a [slug] route's pages out of the sitemap.
import { withBase } from "blume/components/islands/base-path.ts";

import { renderedExamples } from "../site/rendered-examples.ts";
import ExampleEmail from "./example-email.astro";
import SitePage from "./site-page.astro";

interface Props {
  /** The example's `slug` in site/examples.ts. */
  slug: string;
}

const { slug } = Astro.props;
const example = renderedExamples.find((each) => each.slug === slug);
if (!example) {
  throw new Error(`No example email has the slug "${slug}".`);
}
const others = renderedExamples.filter((other) => other !== example);
const kind = example.name.toLowerCase();
/** What the email is, from the start of its text, such as "an order confirmation". */
const what = example.text.split(/[.:]/u)[0] ?? "";
---

<SitePage
  description={`A free ${kind} email template, ${what.charAt(0).toLowerCase()}${what.slice(1)}. Download its HTML, or its JSON to change it in the Mail Quilt editor.`}
  title={`${example.name} email template: free HTML and JSON - Mail Quilt`}
>
  <ExampleEmail
    example={example}
    level="h1"
    title={`${example.name} email template`}
  />

  <section class="site-section">
    <div class="site-wrap site-measure">
      <h2 class="site-h2">Change it</h2>
      <p>
        Download the JSON and open it in the{" "}
        <a class="site-link" href={withBase("/playground")}>Playground</a> with
        Import JSON. Its pictures come in through Merge Tags, so the Playground
        shows placeholders until you give them addresses. To put the editor in
        your own app, start with the{" "}
        <a class="site-link" href={withBase("/docs/quick-start")}>quick start</a>.
      </p>
      <p>
        More examples:{" "}
        {
          others.map((other, index) => (
            <>
              <a class="site-link" href={withBase(`/examples/${other.slug}`)}>
                {other.name}
              </a>
              {index < others.length - 1 ? ", " : "."}
            </>
          ))
        }
      </p>
    </div>
  </section>
</SitePage>
