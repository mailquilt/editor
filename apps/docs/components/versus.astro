---
// One other editor beside Mail Quilt, row by row, with when to choose each.
// The page that uses it holds the other editor's facts, and the date they were
// read on. Mail Quilt's own come from MAIL_QUILT in site/project.ts.
import { MAIL_QUILT } from "../site/project.ts";
import type { CompareRow } from "../site/project.ts";
import ChooseMailQuilt from "./choose-mail-quilt.astro";
import CompareTable from "./compare-table.astro";

interface Props {
  /** The day each line about the other editor was read from its own pages. */
  checked: string;
  /** Reasons to choose Mail Quilt instead. */
  ours: string[];
  /** One fact per row, for both editors. */
  rows: CompareRow[];
  /** The other editor's own pages each line was read from. */
  sources: { href: string; label: string }[];
  /** Reasons to choose the other editor. */
  theirs: string[];
  /** The other editor's name. */
  them: string;
}

const { checked, ours, rows, sources, theirs, them } = Astro.props;
---

<CompareTable
  about={them}
  checked={checked}
  id="side-by-side"
  minWidth="40rem"
  sources={sources}
  title="Side by side">
  <table class="site-table">
    <thead>
      <tr>
        <td></td>
        <th scope="col">Mail Quilt</th>
        <th scope="col">{them}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>{MAIL_QUILT[row.ours]}</td>
            <td>{row.theirs}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</CompareTable>

<section class="site-section">
  <div class="site-wrap site-split">
    <div>
      <h2 class="site-h2">Choose {them} when</h2>
    </div>
    <ul class="site-list">
      {theirs.map((reason) => <li>{reason}</li>)}
    </ul>
  </div>
</section>

<ChooseMailQuilt
  next={{ href: "/compare", label: "Compare it with others" }}
  reasons={ours}
/>
