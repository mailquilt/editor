---
// What's being built now, next and later. The detail lives in GitHub Issues.
// Next and Later are in the order the roadmap in PROJECT.md gives them, so
// change the two together. Nothing here names a version, so it can't go stale.
import SitePage from "../components/site-page.astro";
import { BLOCK_NAMES, COUNTS } from "../site/package-facts.ts";
import { ISSUES } from "../site/project.ts";

const stages = [
  {
    items: [
      "The Shell, a ready-made editor page",
      "The editor, as a Web Component and a React component",
      "The core and the renderer, to change emails and render their HTML in code",
      `${BLOCK_NAMES} Blocks`,
      "Lists in text",
      `Rows of one to ${COUNTS.mostColumns} Columns, with padding, and hiding or stacking on phones`,
      "Drag and drop, with a keyboard path for all of it",
      "Copy, paste and duplicate",
      "Image upload, to storage your app supplies",
      "A Merge Tag picker, filled with your app's tags",
      "Undo and redo, and a preview of the exported HTML at desktop and phone widths",
      "HTML checked in Gmail, Apple Mail, Outlook, Yahoo and other email clients",
    ],
    name: "Now",
    ordered: false,
    planned: false,
    text: "In the current release.",
  },
  {
    items: [
      "A redesigned editor, with three modes, Edit, Style and Check, and editing on phones",
      "Styles for the whole email: colors, fonts, text sizes and button corners",
      "More settings for every Block, Row and Column, with values for phones",
      "A \"decorative\" choice for every image",
      "Web fonts, from a list your app supplies",
      "Menu and Video Blocks",
      "A check before sending: the email in an inbox, its plain text and HTML, what to fix, and a test email sent through your app",
      "Starter emails and saved Rows, from your app",
      "The editor's text in one place, for you to replace",
      "A built-in dark theme for the editor",
      "React 18 in the React components",
      "Vue, Angular and Svelte tested, with types for the element",
      "A JSON Schema for the email format",
      "A docs page for each sending service",
    ],
    name: "Next",
    ordered: false,
    planned: true,
    text: "The redesign, and everything that fits it, in one release.",
  },
  {
    items: [
      "Background images for Rows and Columns",
      "Phone values for more settings than font size, padding and an Image's width",
      "Table and HTML Blocks",
      "Right-to-left emails",
      "The editor's interface in other languages",
      "A plain-text version you can edit",
      "More checks: client support, broken links, and rules you add",
      "Custom Blocks",
      "The editor in parts you arrange yourself",
      "Saving a Row from the editor, to your app",
      "Display rules",
      "Parts of an email that can't be changed",
      "A dark-mode preview",
      "An HTML mode",
      "Import from HTML, MJML and other editors' formats",
      "An MCP server, a command-line tool and a local mode",
      "Writing and editing emails with AI, using your own provider",
      "Vue and Svelte components, if the element alone isn't enough",
      "Export to React Email",
      "Integrations with sending services",
      "Translated emails",
      "A Countdown Block",
      "The pieces for editing an email together",
    ],
    name: "Later",
    ordered: false,
    planned: true,
    text: "Wanted, in this order for the first twelve: seven left out of the redesign's release, then five that open the editor up to your app. The rest have no order yet.",
  },
];
---

<SitePage
  description="What Mail Quilt is building now, next and later. There are no dates, and the roadmap itself lives in GitHub Issues."
  title="Roadmap - Mail Quilt"
>
  <header class="site-intro">
    <div class="site-wrap">
      <h1 class="site-h1">Roadmap</h1>
      <p class="site-lead">
        One person builds Mail Quilt, so nothing here has a date and the order can
        change. A solid outline is in the current release. A dashed one is a plan,
        not a feature.
      </p>
    </div>
  </header>

  <section class="site-section">
    <div class="site-wrap">
      <div class="site-grid">
        {
          stages.map(({ items, name, ordered, planned, text }) => {
            const List = ordered ? "ol" : "ul";
            return (
              // What isn't built yet is a slot, drawn dashed.
              <div class="site-card site-card-body" data-slot={planned ? "" : undefined}>
                <h2 class="site-h3">{name}</h2>
                <p class="site-small site-muted">{text}</p>
                <List class="site-list site-small stage">
                  {items.map((item) => <li>{item}</li>)}
                </List>
              </div>
            );
          })
        }
      </div>
      <p class="site-measure more">
        The roadmap itself is kept in{" "}
        <a class="site-link" href={ISSUES}>GitHub Issues</a>. Comment on what's
        planned there, or open an issue to ask for something that isn't.
      </p>
    </div>
  </section>
</SitePage>

<style>
  .stage {
    margin-top: 1.25rem;
  }

  .stage > li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .more {
    margin-top: 2.5rem;
  }
</style>
