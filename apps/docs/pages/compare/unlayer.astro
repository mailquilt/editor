---
// Mail Quilt beside Unlayer. Every line about Unlayer was read from its own
// site, docs or code on the date below. Check them again before changing it.
import SitePage from "../../components/site-page.astro";
import Versus from "../../components/versus.astro";
import { REASONS } from "../../site/project.ts";
import type { CompareRow } from "../../site/project.ts";

const CHECKED = "16 November 2026";

const rows: CompareRow[] = [
  {
    label: "What it is",
    ours: "what",
    theirs:
      "A commercial editor you embed, with builders for emails, pages, popups and documents.",
  },
  {
    label: "License and cost",
    ours: "cost",
    theirs:
      "A free plan, then Launch at $250 a month, Scale at $750 and Optimize at $2,000, with Enterprise priced on request. The React wrapper is MIT.",
  },
  {
    label: "Where the editor comes from",
    ours: "source",
    theirs:
      "Loaded from Unlayer's servers, at editor.unlayer.com. Running it on-premise or offline is an Enterprise option.",
  },
  {
    label: "Account",
    ours: "account",
    theirs:
      "In production, your domain must be added in the Unlayer Console.",
  },
  {
    label: "Frameworks",
    ours: "frameworks",
    theirs: "React, Angular and Vue wrappers.",
  },
  {
    label: "What you save",
    ours: "saved",
    theirs: "Unlayer's JSON design, which it exports as HTML.",
  },
  {
    label: "Outlook",
    ours: "outlook",
    theirs:
      "Its docs say exports include markup for classic Outlook for Windows by default.",
  },
  {
    label: "Blocks, images and teams",
    ours: "blocks",
    theirs:
      "White-labeling and custom tools from Launch. Custom Blocks, team collaboration and a custom image library from Scale.",
  },
  {
    label: "Support",
    ours: "support",
    theirs: "A company, with a dedicated success manager on Enterprise.",
  },
];

const theirs = [
  "You need page, popup or document builders as well as email.",
  "Your customers expect templates, many kinds of Blocks, image uploads or editing together.",
  "You want a company behind the editor, with a contract and support.",
];

const ours = [
  REASONS.noFee,
  REASONS.saved,
  REASONS.keyboard,
  REASONS.fewBlocks,
];

const sources = [
  { href: "https://unlayer.com/pricing", label: "pricing" },
  { href: "https://docs.unlayer.com", label: "docs" },
  {
    href: "https://github.com/unlayer/react-email-editor",
    label: "React wrapper",
  },
];
---

<SitePage
  description="Mail Quilt and Unlayer side by side: cost, where the editor loads from, frameworks, saved format and classic Outlook, and when Unlayer is the better choice."
  title="An open-source Unlayer alternative: Mail Quilt compared with Unlayer"
>
  <header class="site-intro">
    <div class="site-wrap">
      <h1 class="site-h1">An open-source alternative to Unlayer</h1>
      <p class="site-lead">
        Both put a drag-and-drop email editor in your app. Unlayer is a hosted,
        commercial editor with many more features. Mail Quilt is a set of free, MIT-licensed
        packages that run in your app. This page sets them side by side, and says
        when Unlayer is the better choice.
      </p>
    </div>
  </header>

  <Versus
    checked={CHECKED}
    ours={ours}
    rows={rows}
    sources={sources}
    theirs={theirs}
    them="Unlayer"
  />
</SitePage>
