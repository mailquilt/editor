---
// Mail Quilt beside the other ways to get an email editor into an app.
// Every line about another project was read from its own site or repository
// on COMPARED. Check them again before changing that date.
import { withBase } from "blume/components/islands/base-path.ts";

import ChooseMailQuilt from "../components/choose-mail-quilt.astro";
import CompareTable from "../components/compare-table.astro";
import SitePage from "../components/site-page.astro";
import { COUNTS } from "../site/package-facts.ts";
import { COMPARED, MAIL_QUILT, REASONS } from "../site/project.ts";

const tools = [
  {
    cost: MAIL_QUILT.cost,
    kind: MAIL_QUILT.what,
    name: "Mail Quilt",
    runs: MAIL_QUILT.source,
    works: MAIL_QUILT.frameworks,
  },
  {
    cost: "Commercial. A free plan, then paid plans from $250 a month.",
    href: "https://unlayer.com",
    kind: "A drag-and-drop editor you embed, for emails, pages and more.",
    name: "Unlayer",
    runs: "Loaded from Unlayer's servers.",
    works: "React, Angular and Vue components.",
  },
  {
    cost: "Commercial. A free plan, then paid plans from $400 a month.",
    href: "https://developers.beefree.io",
    kind: "A drag-and-drop editor you embed.",
    name: "Beefree SDK",
    runs: "Loaded from Beefree's servers.",
    works: "React, Angular and Vue.",
  },
  {
    cost: "Commercial. Paid plans from $70 a month, with an API key from Topol.",
    href: "https://topol.io/plugin",
    kind: "A drag-and-drop editor you embed.",
    name: "Topol",
    runs: "Loaded from Topol's servers.",
    works: "React, Vue, Svelte and Angular.",
  },
  {
    cost: "Open-source core under BSD-3. A paid SDK is built on it.",
    href: "https://grapesjs.com",
    kind: "A framework for building visual editors, with a plugin for MJML emails.",
    name: "GrapesJS",
    runs: "In your app, from npm.",
    works: "Plain JavaScript, with a React wrapper.",
  },
  {
    cost: "An MIT version, which doesn't support React 19, and a Pro version from $99 a month.",
    href: "https://easyemail.pro",
    kind: "A drag-and-drop editor you embed.",
    name: "Easy Email",
    runs: "In your app, from npm.",
    works: "React.",
  },
  {
    cost: "FSL-1.1, which becomes MIT two years after each release. Free, but it can't be repackaged as a competing email editor.",
    href: "https://github.com/templatical/sdk",
    kind: "A drag-and-drop editor you embed. It saves JSON and writes MJML.",
    name: "Templatical",
    runs: "In your app, from npm.",
    works: "Any framework. It's built with Vue.",
  },
  {
    cost: "MIT. Free.",
    href: "https://maily.to",
    kind: "An editor that works like writing a document, built on Tiptap.",
    name: "Maily",
    runs: "In your app, from npm.",
    works: "React.",
  },
  {
    cost: "MIT. Free.",
    href: "https://react.email/docs/editor/overview",
    kind: "A rich-text editor for email, built on Tiptap and React Email.",
    name: "React Email editor",
    runs: "In your app, from npm.",
    works: "React 18 or 19.",
  },
  {
    cost: "MIT. Free.",
    href: "https://www.usewaypoint.com/open-source/emailbuilderjs",
    kind: "A block editor that saves JSON or HTML.",
    name: "EmailBuilder.js",
    runs: "In your app. You fork its editor, and its renderer is on npm.",
    works: "React.",
  },
];

const elsewhere = [
  {
    text: "Unlayer, Beefree and Topol are companies with support teams, and you can sign a contract with them. Mail Quilt is one person and a public issue tracker.",
    title: "You need someone to call",
  },
  {
    text: "Mail Quilt's emails work in classic Outlook for Windows, with limits: emoji are black and white, and dark mode inverts the colors. Unlayer's docs say its exports include markup for classic Outlook, Topol says it tests its output in old Outlook, and Beefree says its output works in Outlook. If your emails must look exactly as designed in classic Outlook, compare their output with Mail Quilt's.",
    title: "Your emails must look exactly right in classic Outlook",
  },
  {
    text: `Mail Quilt has ${COUNTS.blocks} Blocks and no template library. The commercial editors have many more Blocks and ready-made templates.`,
    title: "You want templates and a large set of Blocks",
  },
  {
    text: "If developers write your emails and nobody else edits them, you don't need a visual editor. React Email, MJML and Maizzle are built for writing email as code.",
    title: "Your emails are written in code",
  },
  {
    text: "Mail Quilt only makes emails. GrapesJS, Unlayer and Beefree also build web pages.",
    title: "You're building pages as well",
  },
  {
    text: "Maily and React Email's editor feel like writing in a document rather than arranging Blocks, which suits emails that are mostly text.",
    title: "You'd rather write than lay out",
  },
];

const reasons = [
  REASONS.noFee,
  "Your app isn't a React app, or you don't want the choice of editor to depend on your framework.",
  REASONS.saved,
  REASONS.keyboard,
  REASONS.fewBlocks,
];
---

<SitePage
  description="How Mail Quilt compares with Unlayer, Beefree, Topol, GrapesJS, Easy Email, Templatical, Maily, React Email and EmailBuilder.js, and when to choose them."
  title="Mail Quilt compared with Unlayer, Beefree, GrapesJS and others"
>
  <header class="site-intro">
    <div class="site-wrap">
      <h1 class="site-h1">Mail Quilt and the alternatives</h1>
      <p class="site-lead">
        There are good email editors you can embed, and some will suit you better
        than this one. This page says which, and when.
      </p>
    </div>
  </header>

  <CompareTable
    about="another editor"
    checked={COMPARED}
    id="at-a-glance"
    minWidth="54rem"
    title="At a glance">
    <table class="site-table">
      <thead>
        <tr>
          <th scope="col">Editor</th>
          <th scope="col">What it is</th>
          <th scope="col">License and cost</th>
          <th scope="col">Where it runs</th>
          <th scope="col">Works with</th>
        </tr>
      </thead>
      <tbody>
        {
          tools.map(({ cost, href, kind, name, runs, works }) => (
            <tr>
              <th scope="row">
                {href ? (
                  <a class="site-link" href={href}>
                    {name}
                  </a>
                ) : (
                  <span class="ours">{name}</span>
                )}
              </th>
              <td>{kind}</td>
              <td>{cost}</td>
              <td>{runs}</td>
              <td>{works}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="site-measure row-by-row" slot="after">
      Row by row:{" "}
      <a class="site-link" href={withBase("/compare/unlayer")}
        >Mail Quilt and Unlayer</a
      >,{" "}
      <a class="site-link" href={withBase("/compare/beefree")}
        >Mail Quilt and Beefree SDK</a
      >,{" "}
      <a class="site-link" href={withBase("/compare/grapesjs")}
        >Mail Quilt and GrapesJS</a
      >, and{" "}
      <a class="site-link" href={withBase("/compare/easy-email")}
        >Mail Quilt and Easy Email</a
      >.
    </p>
  </CompareTable>

  <section class="site-section">
    <div class="site-wrap">
      <h2 class="site-h2">Choose something else when</h2>
    </div>
    <div class="site-columns">
      {
        elsewhere.map(({ text, title }) => (
          <div>
            <h3 class="site-h3">{title}</h3>
            <p class="site-small">{text}</p>
          </div>
        ))
      }
    </div>
    <div class="site-wrap">
      <p class="site-small site-muted site-measure checked">
        What each editor offers was read from its own site, docs or code on{" "}
        {COMPARED}.
      </p>
    </div>
  </section>

  <ChooseMailQuilt
    next={{ href: "/why", label: "Read why it exists" }}
    reasons={reasons}
  />
</SitePage>

<style>
  .row-by-row,
  .checked {
    margin-top: 1.5rem;
  }
</style>
