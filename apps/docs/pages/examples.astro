---
// Example emails, each rendered when the site is built and shown with its
// Merge Tags filled in. Each one has a page of its own too.
import { withBase } from "blume/components/islands/base-path.ts";

import ExampleEmail from "../components/example-email.astro";
import SitePage from "../components/site-page.astro";
import { renderedExamples } from "../site/rendered-examples.ts";

// Each example's page is a file under pages/examples/, as Blume's sitemap
// lists no [slug] route. So a new example can't be added without one, the
// build stops here and names the file.
const pageFiles = Object.keys(import.meta.glob("./examples/*.astro"));
const withoutPage = renderedExamples.filter(
  ({ slug }) => !pageFiles.includes(`./examples/${slug}.astro`)
);
if (withoutPage.length > 0) {
  throw new Error(
    `An example has no page. Add ${withoutPage
      .map(({ slug }) => `pages/examples/${slug}.astro`)
      .join(", ")}, rendering components/example-page.astro.`
  );
}
---

<SitePage
  description="Example emails made with Mail Quilt: a welcome email, a receipt and a product update, each with the JSON document to open in the Playground."
  title="Example emails: welcome, receipt and product update - Mail Quilt"
>
  <header class="site-intro">
    <div class="site-wrap">
      <h1 class="site-h1">Example emails</h1>
      <p class="site-lead">
        Three emails, each made from the same six Blocks. The previews are the
        real exported HTML, rendered when this site was built. Download a
        document and open it in the{" "}
        <a class="site-link" href={withBase("/playground")}>Playground</a> with
        Import JSON to change it. Each email's pictures come in through Merge
        Tags, so the Playground shows placeholders until you give them addresses.
      </p>
    </div>
  </header>

  {
    renderedExamples.map((example) => (
      <ExampleEmail
        example={example}
        href={withBase(`/examples/${example.slug}`)}
        level="h2"
      />
    ))
  }
</SitePage>
