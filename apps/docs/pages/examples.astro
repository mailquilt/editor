---
// Example emails. Each is rendered here, when the site is built, by the same
// renderer a server would use, then shown with its Merge Tags filled in.
import { loadDocument, MERGE_TAG } from "@mailquilt/core";
import { renderEmail } from "@mailquilt/renderer";
import { withBase } from "blume/components/islands/base-path.ts";

import SitePage from "../components/site-page.astro";
import { examples } from "../site/examples.ts";
import { emailShape, htmlSize } from "../site/measure.ts";

/** What a sending service does: puts a reader's own values where the tags are. */
const fill = (html: string, values: Record<string, string>) => {
  let filled = html;
  for (const [tag, value] of Object.entries(values)) {
    filled = filled.replaceAll(`{{${tag}}}`, value);
  }
  return filled;
};

const rendered = await Promise.all(
  examples.map(async ({ document, sample, ...example }) => {
    const loaded = loadDocument(document);
    if (!loaded.ok) {
      throw new Error(`The ${example.name} example doesn't load: ${loaded.reason}`);
    }
    const json = JSON.stringify(document, null, 2);
    const html = await renderEmail(document);
    const tags = [...new Set(json.match(new RegExp(MERGE_TAG.source, "gu")))];
    // Left unfilled, a tag would show in the preview as its own name.
    const unfilled = tags.filter((tag) => !(tag.slice(2, -2) in sample));
    if (unfilled.length > 0) {
      throw new Error(
        `The ${example.name} example has no sample value for ${unfilled.join(", ")}`
      );
    }
    return {
      ...example,
      document,
      download: `data:application/json;charset=utf-8,${encodeURIComponent(json)}`,
      html,
      preview: fill(html, sample),
      tags,
    };
  })
);
---

<SitePage
  description="Example emails made with Mail Quilt: a welcome email, a receipt and a product update, each with the JSON document to open in the Playground."
  title="Example emails: welcome, receipt and product update - Mail Quilt"
>
  <header class="site-intro">
    <div class="site-wrap">
      <h1 class="site-h1">Example emails</h1>
      <p class="site-lead">
        Three emails, each made from the same six Blocks. The previews are the
        real exported HTML, rendered when this site was built. Download a
        document and open it in the{" "}
        <a class="site-link" href={withBase("/playground")}>Playground</a> with
        Import JSON to change it. Its pictures come in through Merge Tags, so
        each shows a placeholder there until you give it an address.
      </p>
    </div>
  </header>

  {
    rendered.map(({ document, download, html, name, preview, slug, tags, text }) => (
      <section class="site-section example">
        <div class="example-copy">
          <h2 class="site-h2">{name}</h2>
          <p>{text}</p>

          <dl class="site-facts details">
            <div>
              <dt>Its shape</dt>
              <dd>
                {/* A line for each Row, a block for each Column. */}
                <span aria-hidden="true" class="shape">
                  {document.rows.map(({ columns }) => (
                    <span>
                      {columns.map(({ width }) => (
                        <span style={`flex:${width}`} />
                      ))}
                    </span>
                  ))}
                </span>
                <span class="site-small site-muted">{emailShape(document)}</span>
              </dd>
            </div>
            <div>
              <dt>Its HTML</dt>
              <dd class="site-small site-muted">{htmlSize(html)}</dd>
            </div>
            <div>
              <dt>Merge Tags</dt>
              <dd class="tags site-code">
                {tags.map((tag) => (
                  <span class="t">{tag}</span>
                ))}
              </dd>
            </div>
          </dl>

          <div class="site-actions">
            <a
              class="site-button"
              data-tone="quiet"
              download={`${slug}.json`}
              href={download}
            >
              Download the JSON
            </a>
          </div>
        </div>
        <div class="example-preview">
          {/* Scripts stay off. Same-origin only lets this page measure the email's height. */}
          <iframe
            data-example
            loading="lazy"
            sandbox="allow-same-origin"
            srcdoc={preview}
            title={`The ${name} email`}
          />
          <p class="site-small site-muted">
            Shown as a reader would get it, with sample values in place of the
            Merge Tags.
          </p>
        </div>
      </section>
    ))
  }
</SitePage>

<script>
  /**
   * Shows each email whole, at its own height, so nothing scrolls inside the
   * page. The scrollbar goes first, as it would take room and change the height.
   * The root's own box is measured, as its scrollHeight is never less than the
   * frame, so a frame could grow but never shrink.
   */
  const fit = (frame: HTMLIFrameElement) => {
    // A lazy frame shows a blank page until it loads, and that page has no height.
    const loaded = frame.contentDocument?.URL === "about:srcdoc";
    const root = frame.contentDocument?.documentElement;
    if (loaded && root) {
      root.style.overflow = "hidden";
      // The frame's height includes its border, and the email's doesn't.
      const border = frame.offsetHeight - frame.clientHeight;
      const height = Math.ceil(root.getBoundingClientRect().height);
      frame.style.height = `${height + border}px`;
    }
  };

  const frames = () =>
    document.querySelectorAll<HTMLIFrameElement>("iframe[data-example]");

  // Blume moves between pages without reloading, so this runs on each arrival.
  document.addEventListener("astro:page-load", () => {
    for (const frame of frames()) {
      frame.addEventListener("load", () => fit(frame));
      fit(frame);
    }
  });

  // A narrower window wraps the email's text, which makes it taller. Resizing
  // fires many events a frame, so the emails are measured once a frame.
  let fitting = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(fitting);
    fitting = requestAnimationFrame(() => {
      for (const frame of frames()) {
        fit(frame);
      }
    });
  });
</script>

<style>
  /* Copy on one side of the grid, the email on the other, a line between. */
  .example {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
  }

  .example-copy {
    padding: 3.5rem var(--site-gutter) 2.5rem;
  }

  .example-preview {
    padding: 0 var(--site-gutter) 3.5rem;
  }

  @media (min-width: 60rem) {
    .example {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    /* The words stay in view while the email beside them scrolls past. */
    .example-copy {
      position: sticky;
      top: 4rem;
      align-self: start;
      padding-block: 5rem;
    }

    .example-preview {
      padding: 3rem;
      border-inline-start: 1px solid var(--blume-border);
      background: var(--site-surface);
    }
  }

  .details {
    margin-top: 2.25rem;
  }

  .details > div {
    padding-block: 0.875rem;
  }

  .shape {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    width: 7rem;
    margin: 0.1875rem 0 0.625rem;
  }

  .shape > span {
    display: flex;
    gap: 0.1875rem;
    height: 0.5rem;
  }

  .shape > span > span {
    border-radius: 0.125rem;
    background: var(--blume-foreground);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    overflow: visible;
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: normal;
  }

  /* Tall enough to read without its script, which then fits it to the email. */
  .example-preview iframe {
    display: block;
    width: 100%;
    height: 42rem;
    border: 1px solid var(--blume-border);
    border-radius: 0.875rem;
    background: #fff;
  }

  .example-preview > p {
    margin-top: 0.875rem;
  }
</style>
