---
// The Playground: the Shell on a page of its own, with nothing to install.
import Playground from "../components/playground.tsx";
import SitePage from "../components/site-page.astro";
import { EDITOR_MIN_HEIGHT } from "../site/editor-facts.ts";

/*
 * The Shell's height leaves room for the 4rem docs header and the space
 * around it, so it fits the window once scrolled to, and the email scrolls
 * inside it, with the top bar at its top and, on a phone, the Selection bar
 * at its bottom. It's never shorter than the editor, whose top bar is the
 * Shell's header, or the Shell would scroll by a few pixels. The note held in
 * its place until it arrives is as tall.
 */
const roomToEdit = `
  .playground-shell,
  .playground-waiting {
    height: calc(100dvh - 6rem);
    min-height: ${EDITOR_MIN_HEIGHT}px;
  }
`;
---

<SitePage
  description="Try the Mail Quilt email editor in your browser with nothing to install. Your email saves in this browser, and you can export it as JSON or HTML."
  frame={false}
  hideCta
  title="Email editor playground: try it in your browser - Mail Quilt"
>
  <div class="intro">
    <h1 class="site-h2">Playground</h1>
    <p class="site-muted">
      This is the Shell, the ready-made editor page. Your email saves in this
      browser, and you can export it as JSON or HTML.
    </p>
  </div>
  <div class="editor">
    <p class="playground-waiting site-muted">
      The Playground is loading. If it doesn't appear, it needs JavaScript
      turned on.
    </p>
    <Playground client:only="react" />
  </div>
  <style is:inline set:html={roomToEdit}></style>
</SitePage>

<style>
  .intro {
    padding: 1.25rem 1rem 0;
  }

  /* Whole pixels, so the editor below starts on one. Its tests measure it. */
  .intro h1 {
    font-size: 2rem;
    line-height: 2.5rem;
  }

  .intro p {
    margin-top: 0.25rem;
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .editor {
    container-type: inline-size;
    padding: 0 1rem 1.5rem;
  }

  /*
   * The Shell only arrives once its script has run. Until then this note is a
   * slot where it goes, as tall as the Shell and with the same room around
   * it, so the page doesn't jump. It stays if the script never runs, and a
   * note of the same look says so if the editor's code doesn't load.
   */
  .playground-waiting {
    display: none;
  }

  .editor:has(> :global(astro-island:empty)) > .playground-waiting,
  .editor :global(.playground-failed) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    margin-block: 1rem;
    padding: 1.5rem;
    border: var(--site-slot);
    border-radius: 0.875rem;
    text-align: center;
  }

  .editor :global(.playground) {
    container-type: inline-size;
    padding: 1rem 0;
  }

  @media (min-width: 60rem) {
    .intro {
      padding: 1.5rem 1.5rem 0;
    }

    .editor {
      padding: 0 1.5rem 2rem;
    }
  }
</style>
