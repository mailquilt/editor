  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
