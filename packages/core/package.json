{
  "name": "@mailquilt/core",
  "version": "0.0.0",
  "description": "Mail Quilt document model and Commands. Runs without a DOM.",
  "keywords": [
    "document-model",
    "email",
    "email-builder",
    "email-editor"
  ],
  "homepage": "https://github.com/yourcodebuddy-in/mailquilt#readme",
  "bugs": {
    "url": "https://github.com/yourcodebuddy-in/mailquilt/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourcodebuddy-in/mailquilt.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
