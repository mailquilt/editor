{
  "kind": "blocks",
  "version": 4,
  "settings": {
    "width": 600,
    "backgroundColor": "#f4f4f5",
    "fontFamily": "Arial, Helvetica, sans-serif",
    "preheader": "Welcome to the team",
    "language": "en",
    "style": {
      "emailBackgroundColor": "#ffffff",
      "textColor": "#2b1d14",
      "linkColor": "#b5652b",
      "buttonBackgroundColor": "#2b1d14",
      "buttonBorderRadius": 8,
      "headingFontFamily": "Georgia, 'Times New Roman', serif",
      "heading1FontSize": 36,
      "heading2FontSize": 26,
      "heading3FontSize": 21,
      "textFontSize": 15
    }
  },
  "rows": [
    {
      "id": "row-1",
      "props": {
        "backgroundColor": "#ffffff"
      },
      "columns": [
        {
          "id": "column-1",
          "width": 100,
          "props": {},
          "blocks": [
            {
              "id": "block-1",
              "type": "text",
              "props": {
                "align": "center",
                "color": "#333333",
                "fontSize": 18,
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Hello "
                        },
                        {
                          "type": "mergeTag",
                          "attrs": {
                            "name": "first_name"
                          }
                        },
                        {
                          "type": "text",
                          "text": ","
                        },
                        {
                          "type": "hardBreak"
                        },
                        {
                          "type": "text",
                          "text": "see the ",
                          "marks": [
                            {
                              "type": "italic"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "sale",
                          "marks": [
                            {
                              "type": "link",
                              "attrs": {
                                "href": "https://shop.example/sale"
                              }
                            },
                            {
                              "type": "bold"
                            },
                            {
                              "type": "underline"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph"
                    }
                  ]
                },
                "phone": {
                  "fontSize": 16,
                  "paddingTop": 8
                }
              }
            },
            {
              "id": "block-2",
              "type": "heading",
              "props": {
                "align": "left",
                "color": "#111111",
                "fontSize": 28,
                "level": 2,
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Welcome"
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "block-3",
              "type": "image",
              "props": {
                "alt": "{{company}} logo",
                "href": "https://example.com",
                "src": "https://example.com/logo.png",
                "width": 200,
                "phone": {
                  "width": 120
                }
              }
            },
            {
              "id": "block-4",
              "type": "button",
              "props": {
                "align": "right",
                "backgroundColor": "#2563eb",
                "color": "#ffffff",
                "href": "{{cta_url}}",
                "label": "Shop now",
                "showOn": "desktop"
              }
            },
            {
              "id": "block-5",
              "type": "divider",
              "props": {
                "color": "#dddddd",
                "thickness": 2
              }
            },
            {
              "id": "block-6",
              "type": "spacer",
              "props": {
                "height": 40
              }
            }
          ]
        }
      ]
    },
    {
      "id": "row-2",
      "props": {
        "phone": {
          "paddingTop": 0
        },
        "showOn": "phone"
      },
      "columns": [
        {
          "id": "column-2",
          "width": 50,
          "props": {
            "phone": {
              "paddingLeft": 4
            }
          },
          "blocks": []
        },
        {
          "id": "column-3",
          "width": 50,
          "props": {},
          "blocks": []
        }
      ]
    }
  ]
}
