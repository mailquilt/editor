{
  "name": "@mailquilt/editor",
  "version": "0.1.0",
  "description": "Drag-and-drop email editor as Web Components: <mail-quilt> for your own page, and the <mail-quilt-shell> editor page. Works in any framework.",
  "keywords": [
    "custom-elements",
    "drag-and-drop",
    "email",
    "email-builder",
    "email-designer",
    "email-editor",
    "email-template",
    "html-email",
    "lit",
    "web-component",
    "web-components"
  ],
  "homepage": "https://editor.mailquilt.com",
  "bugs": {
    "url": "https://github.com/mailquilt/editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailquilt/editor.git",
    "directory": "packages/editor"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit && tsc --noEmit -p browser-tests && tsc --noEmit -p scripts",
    "test": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mailquilt/core": "workspace:*",
    "@mailquilt/renderer": "workspace:*",
    "lit": "^3.3.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "~1.42.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
