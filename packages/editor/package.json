{
  "name": "@mailquilt/editor",
  "version": "0.0.0",
  "description": "The <mail-quilt> email editor and <mail-quilt-shell> editor page, as Web Components.",
  "keywords": [
    "drag-and-drop",
    "email",
    "email-builder",
    "email-editor",
    "lit",
    "web-component"
  ],
  "homepage": "https://github.com/yourcodebuddy-in/mailquilt#readme",
  "bugs": {
    "url": "https://github.com/yourcodebuddy-in/mailquilt/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourcodebuddy-in/mailquilt.git",
    "directory": "packages/editor"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
