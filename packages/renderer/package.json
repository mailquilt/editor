{
  "name": "@mailquilt/renderer",
  "version": "0.0.0",
  "description": "Turns a Mail Quilt document into email HTML. Runs without a DOM.",
  "keywords": [
    "email",
    "email-builder",
    "email-html",
    "mjml"
  ],
  "homepage": "https://github.com/mailquilt/editor#readme",
  "bugs": {
    "url": "https://github.com/mailquilt/editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailquilt/editor.git",
    "directory": "packages/renderer"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@mailquilt/core": "workspace:*",
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
