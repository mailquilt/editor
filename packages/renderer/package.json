    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mailquilt/core": "workspace:*",
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
