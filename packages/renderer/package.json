{
  "name": "@mailquilt/renderer",
  "version": "0.0.0",
  "description": "Turns a Mail Quilt document into email HTML. Runs without a DOM.",
  "keywords": [
    "email",
    "email-builder",
    "email-html",
    "mjml"
  ],
  "homepage": "https://github.com/yourcodebuddy-in/mailquilt#readme",
  "bugs": {
    "url": "https://github.com/yourcodebuddy-in/mailquilt/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourcodebuddy-in/mailquilt.git",
    "directory": "packages/renderer"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mailquilt/core": "workspace:^",
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
