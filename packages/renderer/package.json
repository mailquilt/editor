{
  "name": "@mailquilt/renderer",
  "version": "0.0.0",
  "description": "Turns a Mail Quilt document into email HTML. Runs without a DOM.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
