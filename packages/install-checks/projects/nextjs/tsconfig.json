{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "resolveJsonModule": true,
    // Or `next build` sets it to true, and skips checking the published types.
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["next-env.d.ts", "app", ".next/types/**/*.ts"]
}
