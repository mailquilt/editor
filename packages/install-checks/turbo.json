{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // The fresh projects are built from the docs' quick-start, Shell, Next.js
      // and server code, and the checks post the docs' example email. Every CDN
      // URL in the docs, the READMEs and the skill must name the editor's version.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/PROJECT.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/apps/docs/docs/**",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/skills/**"
      ]
    }
  }
}
