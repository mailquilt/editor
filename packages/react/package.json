{
  "name": "@mailquilt/react",
  "version": "0.2.0",
  "description": "Drag-and-drop email editor for React: the Mail Quilt editor and editor page as React components.",
  "keywords": [
    "drag-and-drop",
    "email",
    "email-builder",
    "email-designer",
    "email-editor",
    "email-template",
    "html-email",
    "next.js",
    "nextjs",
    "react",
    "react-component"
  ],
  "homepage": "https://editor.mailquilt.com",
  "bugs": {
    "url": "https://github.com/mailquilt/editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailquilt/editor.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit && tsc --noEmit -p browser-tests",
    "test": "playwright test"
  },
  "dependencies": {
    "@mailquilt/editor": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
