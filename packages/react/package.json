{
  "name": "@mailquilt/react",
  "version": "0.0.0",
  "description": "The Mail Quilt email editor as a React component.",
  "keywords": [
    "email",
    "email-builder",
    "email-editor",
    "react"
  ],
  "homepage": "https://github.com/mailquilt/editor#readme",
  "bugs": {
    "url": "https://github.com/mailquilt/editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailquilt/editor.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@mailquilt/editor": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
