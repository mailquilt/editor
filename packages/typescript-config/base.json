{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "incremental": false,
    "isolatedModules": true,
    // The lowest ECMAScript that runs core, the renderer and the editor:
    // ES2023's array methods, which they use, run in Chrome 110, Firefox 115
    // and Safari 16, and the renderer's lookbehinds need Safari 16.4. The
    // packages' builds take the same target, in their tsdown.config.ts.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  }
}
