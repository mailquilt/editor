    "oxlint": "^1.91.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
